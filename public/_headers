/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

/
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: https://wa.alpesdata.app; font-src 'self'; style-src 'self'; script-src 'self' https://wa.alpesdata.app; connect-src 'self' https://wa.alpesdata.app
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: https://wa.alpesdata.app; font-src 'self'; style-src 'self'; script-src 'self' https://wa.alpesdata.app; connect-src 'self' https://wa.alpesdata.app
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=0, must-revalidate

/bootstrap
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=0, must-revalidate

/bootstrap.html
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=0, must-revalidate


/demo/*
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600

/screenshots/*
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=3600

/channels/*
  Cache-Control: public, max-age=60

/beta/install.sh
  X-Robots-Tag: noindex

/install.sh
  X-Robots-Tag: noindex
